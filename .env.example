# Copia este archivo como ".env" y rellena los valores.
# IMPORTANTE: estas variables NO empiezan con VITE_, así nunca llegan al navegador.

# Clave de KIE.ai (una sola clave para video, imagen, voz, avatar y textos)
# Consíguela en: https://kie.ai/api-key
KIE_API_KEY=

# Contraseña para usar la app cuando esté publicada (obligatoria en Vercel).
# En tu PC puedes dejarla vacía.
APP_PASSWORD=
